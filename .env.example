# Private PayanAgent fulfillment token. Use a random value of at least 32 characters.
PAYANAGENT_DELIVERY_SECRET=

# Optional Coinbase CDP facilitator credentials. When both are present,
# production x402 verification and settlement use Coinbase CDP so successful
# paid routes can qualify for Coinbase Bazaar indexing.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
