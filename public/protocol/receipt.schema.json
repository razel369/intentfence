{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass-protocol.rmalka06.chatgpt.site/protocol/receipt.schema.json",
  "title": "IntentFence Signed Receipt Claims",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "iss",
    "aud",
    "iat",
    "exp",
    "jti",
    "intentfence_version",
    "assurance",
    "request_id",
    "decision",
    "subject",
    "action",
    "checks"
  ],
  "properties": {
    "iss": { "const": "https://agentpass-protocol.rmalka06.chatgpt.site" },
    "aud": { "const": "intentfence-verifier" },
    "iat": { "type": "integer" },
    "exp": { "type": "integer" },
    "jti": { "type": "string", "minLength": 1, "maxLength": 200 },
    "intentfence_version": { "enum": ["0.5", "0.6", "0.7", "0.8", "0.9", "1.0"] },
    "assurance": {
      "enum": ["declared-input-policy", "caller-observed-x402-quote-assessment", "live-x402-endpoint-readiness", "live-base-wallet-risk", "official-source-data", "action-bound-policy-authorization"]
    },
    "request_id": { "type": "string", "format": "uuid" },
    "decision": {
      "enum": ["safe_to_proceed", "needs_review", "denied", "verified"]
    },
    "subject": { "type": ["string", "null"] },
    "action": { "type": ["object", "null"] },
    "checks": { "type": "array" },
    "evidence": { "type": "object" },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "network", "asset", "amount_atomic", "pay_to"],
      "properties": {
        "protocol": { "const": "x402-v2" },
        "network": { "type": "string" },
        "asset": { "type": "string" },
        "amount_atomic": { "type": "string" },
        "pay_to": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "assurance": { "not": { "const": "action-bound-policy-authorization" } } }
      },
      "then": { "required": ["payment"] }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "caller-observed-x402-quote-assessment" }
        }
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "intentfence_version": { "const": "0.6" },
          "evidence": {
            "type": "object",
            "required": [
              "assessed_at",
              "target_url_sha256",
              "target_origin",
              "target_pathname",
              "target_method",
              "payment_requirements_sha256"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "declared-input-policy" }
        }
      },
      "then": {
        "properties": {
          "intentfence_version": { "const": "0.5" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "live-base-wallet-risk" }
        }
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "intentfence_version": { "const": "0.7" },
          "evidence": {
            "type": "object",
            "required": [
              "assessed_at",
              "address",
              "network",
              "block_number",
              "malicious_flags",
              "intelligence_source"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "official-source-data" }
        }
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "intentfence_version": { "const": "0.8" },
          "decision": { "const": "verified" },
          "evidence": {
            "type": "object",
            "required": [
              "publisher",
              "source_api",
              "retrieved_at",
              "period",
              "series_ids",
              "headline_index",
              "core_index"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "live-x402-endpoint-readiness" }
        }
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "intentfence_version": { "const": "0.9" },
          "evidence": {
            "type": "object",
            "required": ["checked_at", "target_origin", "target_pathname", "target_method", "http_status", "payment_required_present", "redirect_blocked", "payment_requirements_sha256"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "assurance": { "const": "action-bound-policy-authorization" }
        }
      },
      "then": {
        "required": ["evidence"],
        "properties": {
          "intentfence_version": { "const": "1.0" },
          "evidence": {
            "type": "object",
            "required": ["authorized_at", "action_digest", "policy_digest", "enforcement_mode"],
            "properties": {
              "action_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "enforcement_mode": { "const": "caller-side-fail-closed" }
            }
          }
        }
      }
    }
  ]
}
