{
  "openapi": "3.1.0",
  "info": {
    "title": "IntentFence Policy API",
    "version": "0.11.0",
    "description": "Inspect live x402 endpoints without paying them, retrieve signed official U.S. CPI data, and guard autonomous agent payments with Base wallet screening, policy checks, and quote assessments. Paid endpoints return ES256-signed receipts.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "contact": { "url": "https://github.com/razel369/intentfence" },
    "x-guidance": "Before signing an x402 payment, inspect a live endpoint with /api/x402-readiness, screen its recipient with /api/wallet-risk, or forward an already-observed PAYMENT-REQUIRED header to /api/x402-assessments. Use the free preflight for a declared-input preview."
  },
  "servers": [
    { "url": "https://agentpass-protocol.rmalka06.chatgpt.site" }
  ],
  "security": [],
  "x-agentcash-guidance": {
    "llmsTxtUrl": "https://agentpass-protocol.rmalka06.chatgpt.site/llms.txt"
  },
  "paths": {
    "/api/preflight": {
      "post": {
        "operationId": "runFreePreflight",
        "summary": "Evaluate an agent action with an unsigned preview",
        "tags": ["agent-policy", "security", "preflight"],
        "security": [],
        "x-price": "free",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PreflightRequest" },
              "example": {
                "subject": "did:web:crew-07",
                "action": { "type": "travel.booking", "resource": "TLV-LHR" },
                "constraints": {
                  "currency": "USD",
                  "cost_ceiling": 500,
                  "quoted_cost": 428.2,
                  "data_retention_hours": 24,
                  "human_approval": "required"
                },
                "proofs": ["human_approval"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unsigned preflight decision",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PreflightDecision" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "413": { "description": "JSON body exceeds 16 KiB" },
          "415": { "description": "Unsupported content type" }
        }
      }
    },
    "/api/preflight/verified": {
      "post": {
        "operationId": "runX402Preflight",
        "summary": "Run an AI-agent payment safety and policy preflight",
        "description": "Paid x402 policy and spend-control preflight for AI agents before a consequential action or payment. Evaluates the caller-declared action, quoted cost against its ceiling, data-retention limit, approval requirement, and approval proof; returns safe_to_proceed, needs_review, or denied with an ES256 JWS audit receipt. The IntentFence service fee is 0.005 USDC using x402 v2 exact payment on Base mainnet (eip155:8453): call once without payment to receive PAYMENT-REQUIRED, then retry with PAYMENT-SIGNATURE. Settlement proof is returned in PAYMENT-RESPONSE.",
        "tags": ["agent-policy", "payment-safety", "spend-control", "preflight", "security", "x402", "agent-commerce"],
        "security": [],
        "x-payment-info": {
          "price": { "mode": "fixed", "currency": "USD", "amount": "0.005" },
          "protocols": [
            {
              "x402": {
                "version": 2,
                "network": "eip155:8453",
                "asset": "USDC",
                "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
              }
            }
          ]
        },
        "x-x402-price": "$0.005",
        "x-x402": {
          "version": 2,
          "scheme": "exact",
          "price": "0.005 USDC",
          "network": "eip155:8453",
          "asset": "USDC",
          "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
        },
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "description": "Base64-encoded x402 v2 payment payload returned by an x402-compatible client.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PreflightRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid preflight decision after settlement",
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded x402 settlement result, including on-chain transaction proof.",
                "schema": { "type": "string" }
              },
              "X-IntentFence-Request-ID": {
                "description": "IntentFence audit correlation identifier.",
                "schema": { "type": "string", "format": "uuid" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaidPreflightDecision" }
              }
            }
          },
          "402": {
            "description": "Payment is required or the supplied payment could not be verified",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 payment requirements.",
                "required": true,
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "413": { "description": "JSON body exceeds 16 KiB; a verified payment is not settled" },
          "415": { "description": "Unsupported content type; a verified payment is not settled" }
        }
      }
    },
    "/api/x402-assessments": {
      "post": {
        "operationId": "createX402Assessment",
        "summary": "Assess a caller-observed x402 quote before paying it",
        "description": "Creates a signed assessment of the exact PAYMENT-REQUIRED challenge observed by the caller. IntentFence does not fetch or purchase the target resource. The assessment validates the official x402 v2 schema, exact payment, Base mainnet, canonical Base USDC and EIP-712 domain, the caller's precise price ceiling, payee policy, timeout, transfer method, extensions, and exact resource-URL binding. Permit2 or unknown active extensions require review. A decision can be safe_to_proceed only when allowed_payees is supplied and every advertised payment option satisfies every automatic check; a mixed safe and unsafe option set is denied. The IntentFence assessment itself costs 0.005 USDC through x402, with atomic EIP-3009 payer-and-nonce replay reservation.",
        "tags": ["x402", "agent-commerce", "merchant-risk", "payment-safety"],
        "security": [],
        "x-payment-info": {
          "price": { "mode": "fixed", "currency": "USD", "amount": "0.005" },
          "protocols": [
            {
              "x402": {
                "version": 2,
                "network": "eip155:8453",
                "asset": "USDC",
                "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
              }
            }
          ]
        },
        "x-x402-price": "$0.005",
        "x-x402": {
          "version": 2,
          "scheme": "exact",
          "price": "0.005 USDC",
          "network": "eip155:8453",
          "asset": "USDC",
          "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
        },
        "parameters": [
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "description": "Base64-encoded x402 v2 payment payload. Omit on the first call to receive PAYMENT-REQUIRED.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/X402AssessmentRequest" },
              "example": {
                "subject": "agent:buyer-07",
                "target_url": "https://merchant.example/api/paid-resource",
                "method": "GET",
                "payment_required": "",
                "policy": {
                  "max_price_usdc": "0.10",
                  "allowed_payees": ["0x1111111111111111111111111111111111111111"]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Caller-observed quote assessment created and the IntentFence fee settled",
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded x402 settlement result for the IntentFence assessment fee.",
                "schema": { "type": "string" }
              },
              "X-IntentFence-Request-ID": {
                "description": "Assessment and audit correlation identifier.",
                "schema": { "type": "string", "format": "uuid" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/X402AssessmentDecision" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "402": {
            "description": "Payment is required or the supplied payment could not be verified",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 payment requirements.",
                "required": true,
                "schema": { "type": "string" }
              }
            }
          },
          "409": {
            "description": "The EIP-3009 payer and nonce authorization is already in flight or was already used",
            "headers": {
              "Retry-After": {
                "description": "Seconds before a transient in-flight conflict may be retried with a fresh authorization.",
                "schema": { "type": "integer", "minimum": 1 }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Problem" }
              }
            }
          },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/x402-readiness": {
      "post": {
        "operationId": "checkLiveX402Readiness",
        "summary": "Check a live x402 endpoint without paying it",
        "description": "Makes one bounded credential-free request to a public HTTPS endpoint, blocks redirects and private-network targets, validates the live PAYMENT-REQUIRED challenge against a price ceiling and optional payee allowlist, never pays the target, and returns a signed five-minute receipt. Costs 0.002 USDC through x402.",
        "tags": ["x402", "endpoint-readiness", "payment-safety", "security"],
        "security": [],
        "x-payment-info": { "price": { "mode": "fixed", "currency": "USD", "amount": "0.002" }, "protocols": [{ "x402": { "version": 2, "network": "eip155:8453", "asset": "USDC", "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e" } }] },
        "x-x402-price": "$0.002",
        "parameters": [{ "name": "PAYMENT-SIGNATURE", "in": "header", "required": false, "description": "Base64-encoded x402 v2 payment payload. Omit on the first call to receive PAYMENT-REQUIRED.", "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/X402ReadinessRequest" }, "example": { "target_url": "https://merchant.example/paid", "method": "GET", "max_price_usdc": "0.01", "allowed_payees": ["0x1111111111111111111111111111111111111111"] } } } },
        "responses": {
          "200": { "description": "Live readiness result returned and the IntentFence fee settled", "headers": { "PAYMENT-RESPONSE": { "description": "Base64-encoded x402 settlement result.", "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/X402ReadinessDecision" } } } },
          "400": { "$ref": "#/components/responses/Problem" },
          "402": { "description": "Payment is required or could not be verified" },
          "409": { "$ref": "#/components/responses/Problem" },
          "413": { "$ref": "#/components/responses/Problem" },
          "415": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/wallet-risk": {
      "get": {
        "operationId": "assessBaseWalletRisk",
        "summary": "Screen a Base wallet for sanctions, phishing, and counterparty risk",
        "description": "Paid AML/KYT wallet screening before sending USDC or interacting with an unknown Base recipient. Uses live Base RPC activity and GoPlus malicious-address intelligence to check sanctions exposure, phishing, mixers, money laundering, dark-web activity, blacklists, cybercrime, and related risk flags. A low-risk result means no listed malicious flags were observed and the address was established on Base at assessment time; it does not prove identity, ownership, authorization, or future behavior. Costs 0.002 USDC through x402 and returns a five-minute ES256 receipt.",
        "tags": ["wallet-intelligence", "counterparty-risk", "security", "x402"],
        "security": [],
        "x-payment-info": {
          "price": { "mode": "fixed", "currency": "USD", "amount": "0.002" },
          "protocols": [
            {
              "x402": {
                "version": 2,
                "network": "eip155:8453",
                "asset": "USDC",
                "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
              }
            }
          ]
        },
        "x-x402-price": "$0.002",
        "x-x402": {
          "version": 2,
          "scheme": "exact",
          "price": "0.002 USDC",
          "network": "eip155:8453",
          "asset": "USDC",
          "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
        },
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": true,
            "description": "Base wallet or counterparty address to screen before sending funds, approving a transaction, or interacting with a contract.",
            "schema": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
            "example": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e"
          },
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "description": "Base64-encoded x402 v2 payment payload. Omit on the first call to receive PAYMENT-REQUIRED.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Live wallet-risk assessment created and the IntentFence fee settled",
            "headers": {
              "PAYMENT-RESPONSE": {
                "description": "Base64-encoded x402 settlement result for the assessment fee.",
                "schema": { "type": "string" }
              },
              "X-IntentFence-Request-ID": {
                "description": "Assessment and audit correlation identifier.",
                "schema": { "type": "string", "format": "uuid" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletRiskDecision" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "402": {
            "description": "Payment is required or the supplied payment could not be verified",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 payment requirements for 0.002 USDC.",
                "required": true,
                "schema": { "type": "string" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/us-cpi": {
      "get": {
        "operationId": "getOfficialUsCpi",
        "summary": "Retrieve signed official U.S. CPI and core CPI data",
        "description": "Returns official Bureau of Labor Statistics headline and core CPI index values and year-over-year rates. Results use a six-hour edge cache and include an ES256 provenance receipt. Costs 0.001 USDC through x402.",
        "tags": ["official-data", "inflation", "x402", "agent-commerce"],
        "security": [],
        "x-payment-info": {
          "price": { "mode": "fixed", "currency": "USD", "amount": "0.001" },
          "protocols": [{ "x402": { "version": 2, "network": "eip155:8453", "asset": "USDC", "payTo": "0x833ca7dcdb6a681ddc0c15982ef0d609bceb3a5e" } }]
        },
        "x-x402-price": "$0.001",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "Optional historical period in YYYY-MM format. Omit for the latest common headline/core period with a year-over-year comparison.",
            "schema": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$" }
          },
          {
            "name": "PAYMENT-SIGNATURE",
            "in": "header",
            "required": false,
            "description": "Base64-encoded x402 v2 payment payload. Omit on the first call to receive PAYMENT-REQUIRED.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Official CPI data returned and the IntentFence fee settled",
            "headers": { "PAYMENT-RESPONSE": { "description": "Base64-encoded x402 settlement result.", "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsCpiDecision" } } }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "402": { "description": "Payment is required or could not be verified" },
          "409": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" },
          "503": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/receipts/verify": {
      "post": {
        "operationId": "verifyIntentFenceReceipt",
        "summary": "Verify an IntentFence ES256 compact JWS receipt",
        "tags": ["agent-policy", "security", "receipt-verification"],
        "security": [],
        "x-price": "free",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["jws"],
                "properties": {
                  "jws": { "type": "string", "minLength": 100, "maxLength": 32768 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The receipt signature and registered claims are valid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["valid", "claims"],
                  "properties": {
                    "valid": { "const": true },
                    "claims": { "$ref": "#/components/schemas/ReceiptClaims" }
                  }
                }
              }
            }
          },
          "400": { "description": "Malformed, expired, unsupported, or invalid receipt" },
          "413": { "description": "JSON body exceeds 36 KiB" },
          "415": { "description": "Unsupported content type" }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getIntentFenceHealth",
        "summary": "Read service and protocol availability",
        "security": [],
        "responses": {
          "200": {
            "description": "IntentFence service status",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "429": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/payments": {
      "get": {
        "operationId": "getPaymentMetadata",
        "summary": "Read live x402 price, recipient, flow, and capped Agentic Wallet checkout",
        "security": [],
        "responses": {
          "200": {
            "description": "Public payment configuration",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "429": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "operationId": "getPublicRevenueMetrics",
        "summary": "Read aggregate verified usage, settlement, and revenue counters",
        "security": [],
        "responses": {
          "200": {
            "description": "Privacy-safe aggregate funnel and x402 settlement metrics",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "429": { "$ref": "#/components/responses/Problem" },
          "503": { "description": "Metrics database is temporarily unavailable" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Problem": {
        "description": "Problem Details error response",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "InvalidRequest": {
        "description": "Invalid JSON or preflight fields",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error", "message"],
              "properties": {
                "error": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ReceiptClaims": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "iss",
          "aud",
          "iat",
          "exp",
          "jti",
          "intentfence_version",
          "assurance",
          "request_id",
          "decision",
          "subject",
          "action",
          "checks",
          "payment"
        ],
        "properties": {
          "iss": { "type": "string", "const": "https://agentpass-protocol.rmalka06.chatgpt.site" },
          "aud": { "type": "string", "const": "intentfence-verifier" },
          "iat": { "type": "integer" },
          "exp": { "type": "integer" },
          "jti": { "type": "string", "minLength": 1, "maxLength": 200 },
          "intentfence_version": { "type": "string", "enum": ["0.5", "0.6", "0.7", "0.8", "0.9"] },
          "assurance": {
            "type": "string",
            "enum": ["declared-input-policy", "caller-observed-x402-quote-assessment", "live-base-wallet-risk", "official-source-data", "live-x402-endpoint-readiness"]
          },
          "request_id": { "type": "string", "format": "uuid" },
          "decision": {
            "type": "string",
            "enum": ["safe_to_proceed", "needs_review", "denied", "verified"]
          },
          "subject": { "type": ["string", "null"] },
          "action": { "type": ["object", "null"] },
          "checks": { "type": "array", "items": { "type": "object" } },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assessed_at",
              "target_url_sha256",
              "target_origin",
              "target_pathname",
              "target_method",
              "payment_requirements_sha256"
            ],
            "properties": {
              "assessed_at": { "type": "string", "format": "date-time" },
              "target_url_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "target_origin": { "type": "string", "format": "uri" },
              "target_pathname": { "type": "string" },
              "target_method": { "type": "string", "enum": ["GET", "HEAD", "POST"] },
              "payment_requirements_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "payment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "network", "asset", "amount_atomic", "pay_to"],
            "properties": {
              "protocol": { "type": "string", "const": "x402-v2" },
              "network": { "type": "string" },
              "asset": { "type": "string" },
              "amount_atomic": { "type": "string" },
              "pay_to": { "type": "string" }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "detail", "instance"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string" },
          "instance": { "type": "string" }
        }
      },
      "X402AssessmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "target_url", "payment_required", "policy"],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "agent:x402scan-probe"
          },
          "target_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "HTTPS resource URL that the caller associates with the observed quote. IntentFence does not fetch this URL.",
            "example": "https://merchant.example/api/paid-resource"
          },
          "method": { "type": "string", "enum": ["GET", "HEAD", "POST"], "default": "GET" },
          "payment_required": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "^[A-Za-z0-9+/_-]+={0,2}$",
            "description": "Exact base64 or base64url PAYMENT-REQUIRED response header observed by the caller. IntentFence hashes and evaluates this quote without contacting the target.",
            "example": ""
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_price_usdc"],
            "properties": {
              "max_price_usdc": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$",
                "description": "Precise USDC ceiling as a decimal string.",
                "example": "0.10"
              },
              "allowed_payees": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "description": "Approved EVM recipients. When omitted, the assessment cannot return safe_to_proceed and returns needs_review unless another check denies the quote.",
                "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
              }
            }
          }
        }
      },
      "X402AssessmentDecision": {
        "type": "object",
        "required": [
          "intentfence",
          "request_id",
          "status",
          "assessed_at",
          "target",
          "observed",
          "checks",
          "verification_tier",
          "receipt"
        ],
        "properties": {
          "intentfence": { "const": "0.6" },
          "request_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["safe_to_proceed", "needs_review", "denied"]
          },
          "assessed_at": { "type": "string", "format": "date-time" },
          "target": {
            "type": "object",
            "required": ["origin", "pathname", "has_query", "method", "url_sha256"],
            "properties": {
              "origin": { "type": "string", "format": "uri" },
              "pathname": { "type": "string" },
              "has_query": { "type": "boolean" },
              "method": { "type": "string", "enum": ["GET", "HEAD", "POST"] },
              "url_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "observed": {
            "type": "object",
            "required": [
              "challenge_source",
              "x402_version",
              "payment_requirements_sha256",
              "accepts"
            ],
            "properties": {
              "challenge_source": {
                "type": "string",
                "const": "caller-supplied-payment-required"
              },
              "x402_version": { "type": "integer", "const": 2 },
              "payment_requirements_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "accepts": { "type": "array", "items": { "type": "object" } }
            }
          },
          "checks": { "type": "array", "items": { "type": "object" } },
          "verification_tier": {
            "type": "string",
            "const": "x402-quote-assessment+x402-settled"
          },
          "receipt": {
            "type": "object",
            "required": ["signed", "assurance", "expires_at", "signature"],
            "properties": {
              "signed": { "const": true },
              "assurance": {
                "type": "string",
                "const": "caller-observed-x402-quote-assessment"
              },
              "expires_at": { "type": "string", "format": "date-time" },
              "signature": { "type": "object" }
            }
          }
        }
      },
      "X402ReadinessRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_url"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
          "target_url": { "type": "string", "format": "uri", "maxLength": 2048, "description": "Public HTTPS endpoint on the standard port." },
          "method": { "type": "string", "enum": ["GET", "HEAD", "POST"], "default": "GET" },
          "body": {},
          "max_price_usdc": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,6})?$", "default": "1.00" },
          "allowed_payees": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" } }
        }
      },
      "X402ReadinessDecision": {
        "type": "object",
        "required": ["intentfence", "request_id", "status", "checked_at", "target", "observed", "checks", "assessment", "verification_tier", "receipt"],
        "properties": {
          "intentfence": { "type": "string", "const": "0.9" },
          "request_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["ready", "ready_with_review", "not_ready"] },
          "checked_at": { "type": "string", "format": "date-time" },
          "target": { "type": "object" },
          "observed": { "type": "object" },
          "checks": { "type": "array", "items": { "type": "object" } },
          "assessment": { "type": ["object", "null"] },
          "verification_tier": { "type": "string", "const": "live-x402-readiness+x402-settled" },
          "receipt": { "type": "object" }
        }
      },
      "WalletRiskDecision": {
        "type": "object",
        "required": [
          "intentfence",
          "request_id",
          "status",
          "risk_level",
          "risk_score",
          "assessed_at",
          "subject",
          "observed",
          "checks",
          "verification_tier",
          "receipt"
        ],
        "properties": {
          "intentfence": { "type": "string", "const": "0.7" },
          "request_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["safe_to_proceed", "needs_review", "denied"]
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "critical"]
          },
          "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "assessed_at": { "type": "string", "format": "date-time" },
          "subject": {
            "type": "object",
            "required": ["address", "network", "account_type"],
            "properties": {
              "address": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
              "network": { "type": "string", "const": "eip155:8453" },
              "account_type": { "type": "string", "enum": ["eoa", "contract"] }
            }
          },
          "observed": {
            "type": "object",
            "required": [
              "block_number",
              "transaction_count",
              "native_balance_wei",
              "usdc_balance_atomic",
              "malicious_flags",
              "intelligence_source"
            ],
            "properties": {
              "block_number": { "type": "string", "pattern": "^[0-9]+$" },
              "transaction_count": { "type": "string", "pattern": "^[0-9]+$" },
              "native_balance_wei": { "type": "string", "pattern": "^[0-9]+$" },
              "usdc_balance_atomic": { "type": "string", "pattern": "^[0-9]+$" },
              "code_sha256": { "type": ["string", "null"] },
              "malicious_flags": { "type": "array", "items": { "type": "string" } },
              "malicious_contracts_created": { "type": "integer", "minimum": 0 },
              "intelligence_source": { "type": "string" }
            }
          },
          "checks": { "type": "array", "items": { "type": "object" } },
          "verification_tier": {
            "type": "string",
            "const": "live-base-wallet-risk+x402-settled"
          },
          "receipt": {
            "type": "object",
            "required": ["signed", "assurance", "expires_at", "signature"],
            "properties": {
              "signed": { "const": true },
              "assurance": { "type": "string", "const": "live-base-wallet-risk" },
              "expires_at": { "type": "string", "format": "date-time" },
              "signature": { "type": "object" }
            }
          }
        }
      },
      "UsCpiDecision": {
        "type": "object",
        "required": ["intentfence", "request_id", "status", "source", "period", "cpi", "summary", "checks", "receipt"],
        "properties": {
          "intentfence": { "type": "string", "const": "0.8" },
          "request_id": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "const": "verified" },
          "source": { "type": "object" },
          "period": {
            "type": "object",
            "required": ["year", "month", "name"],
            "properties": { "year": { "type": "string" }, "month": { "type": "string" }, "name": { "type": "string" } }
          },
          "cpi": {
            "type": "object",
            "required": ["headline_index", "headline_yoy_percent", "core_index", "core_yoy_percent"],
            "properties": {
              "headline_index": { "type": "number" },
              "headline_yoy_percent": { "type": "number" },
              "core_index": { "type": "number" },
              "core_yoy_percent": { "type": "number" }
            }
          },
          "summary": { "type": "string" },
          "checks": { "type": "array", "items": { "type": "object" } },
          "receipt": { "type": "object" }
        }
      },
      "PreflightRequest": {
        "type": "object",
        "required": ["subject", "action"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
          "action": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "minLength": 1, "maxLength": 120 },
              "resource": { "type": "string", "maxLength": 500 }
            }
          },
          "constraints": {
            "type": "object",
            "properties": {
              "currency": { "type": "string", "maxLength": 12 },
              "cost_ceiling": { "type": "number", "minimum": 0 },
              "quoted_cost": { "type": "number", "minimum": 0 },
              "data_retention_hours": { "type": "number", "minimum": 0 },
              "human_approval": {
                "type": "string",
                "enum": ["required", "optional", "not_required"]
              }
            }
          },
          "proofs": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string", "maxLength": 200 }
          }
        }
      },
      "PreflightDecision": {
        "type": "object",
        "required": ["intentfence", "request_id", "status", "checks", "receipt"],
        "properties": {
          "intentfence": { "type": "string", "const": "0.5" },
          "request_id": { "type": "string", "format": "uuid" },
          "status": {
            "type": "string",
            "enum": ["safe_to_proceed", "needs_review", "denied"]
          },
          "checks": { "type": "array", "items": { "type": "object" } },
          "receipt": { "type": "object" }
        }
      },
      "PaidPreflightDecision": {
        "allOf": [
          { "$ref": "#/components/schemas/PreflightDecision" },
          {
            "type": "object",
            "required": ["verification_tier"],
            "properties": {
              "verification_tier": { "type": "string", "const": "x402-settled" }
            }
          }
        ]
      }
    }
  }
}
